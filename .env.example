# Copiar para .env.local e preencher com os valores reais (fornecidos pelo Head of Tech).
# Nunca commitar .env.local — já está no .gitignore.
# Na Vercel: Project → Settings → Environment Variables (Production e Preview), depois redeploy.

# ── Agenda do site (página Contacto) ─────────────────────────────────────
# Calendário com os dias livres e ocupados, os horários do dia e a marcação.
# As marcações ficam no Supabase: criar as tabelas com docs/sql/bookings.sql.
#   BOOKING_STORE=supabase  liga a agenda (precisa das duas variáveis abaixo)
#   BOOKING_STORE=off       desliga-a
#   (vazio)                 local: ficheiro na pasta temporária; previews da Vercel:
#                           demonstração (nada é guardado nem enviado); produção: desligada
BOOKING_STORE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Emails da agenda: aviso à equipa e confirmação a quem marca, com convite .ics.
# O email neroes.tech está no Google Workspace, por isso bastam duas variáveis:
#   SMTP_USER  uma conta @neroes.tech (ex.: info@neroes.tech)
#   SMTP_PASS  uma "palavra-passe de app" dessa conta (16 caracteres), criada em
#              https://myaccount.google.com/apppasswords — exige a verificação em 2 passos.
# Sem elas, a marcação fica guardada na mesma, mas ninguém recebe email.
SMTP_USER=
SMTP_PASS=
# Só para outro fornecedor que não o Google:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Para onde vão os avisos de novas marcações (por defeito info@neroes.tech):
# CONTACT_TO_EMAIL=info@neroes.tech

# Alternativa sem a agenda do site: embutir uma agenda externa.
# Google Calendar → a agenda de marcações → Partilhar → Incorporar no site →
# "Calendário em linha" → copiar. Pode colar-se o código <iframe> inteiro ou só
# o link, ex.: https://calendar.google.com/calendar/appointments/schedules/AcZssZ...
# (os links curtos calendar.app.google/... não se deixam embutir).
# Também aceita um evento Calendly: https://calendly.com/<utilizador>/<evento>
# Sem este valor, a página mostra a alternativa por email/telefone em vez do calendário.
NEXT_PUBLIC_BOOKING_URL=
