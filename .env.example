# Copiar para .env.local e preencher com os valores reais (fornecidos pelo Head of Tech).
# Nunca commitar .env.local — já está no .gitignore.
# Na Vercel: Project → Settings → Environment Variables (Production e Preview), depois redeploy.

# Supabase — reservado para dados/autenticação futuros (hoje o site não o usa).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Página Contacto → calendário de marcação, com os dias e horas livres da equipa.
# Google Calendar → a agenda de marcações → Partilhar → Incorporar no site →
# "Calendário em linha" → copiar. Pode colar-se o código <iframe> inteiro ou só
# o link, ex.: https://calendar.google.com/calendar/appointments/schedules/AcZssZ...
# (os links curtos calendar.app.google/... não se deixam embutir).
# Também aceita um evento Calendly: https://calendly.com/<utilizador>/<evento>
# Sem este valor, a página mostra a alternativa por email/telefone em vez do calendário.
NEXT_PUBLIC_BOOKING_URL=
