# Copiar para .env.local e preencher com os valores reais (fornecidos pelo Head of Tech).
# Nunca commitar .env.local — já está no .gitignore.
# Na Vercel: Project → Settings → Environment Variables (Production e Preview), depois redeploy.

# Supabase — opcional. Se estiver configurado, guarda também uma cópia de cada mensagem
# na tabela contact_submissions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Formulário de contacto → email para a empresa.
# O email neroes.tech está no Google Workspace, por isso bastam duas variáveis:
#   SMTP_USER  uma conta @neroes.tech (ex.: info@neroes.tech)
#   SMTP_PASS  uma "palavra-passe de app" dessa conta (16 caracteres), criada em
#              https://myaccount.google.com/apppasswords — exige a verificação em 2 passos ativa.
# Testar sem usar o formulário:  npm run mail:check   (e  npm run mail:check -- --send  para um email de teste)
SMTP_USER=
SMTP_PASS=
# Só para outro fornecedor que não o Google:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Para onde vão as mensagens (por defeito info@neroes.tech):
# CONTACT_TO_EMAIL=info@neroes.tech
